<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>personal.auditoria-plenarias.semanal</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>-E</string>
    <string>-P</string>
    <string>/Users/joselito/Proyecto Auditoria Congreso/scripts/corte_semanal.py</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/joselito/Proyecto Auditoria Congreso</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/Users/joselito/.npm-global/bin:/Users/joselito/.local/bin:/usr/bin:/bin</string>
  </dict>
  <!-- Lunes a las 6:30: actas nuevas, datos del informe, despliegue en Vercel y GitHub -->
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key>
    <integer>1</integer>
    <key>Hour</key>
    <integer>6</integer>
    <key>Minute</key>
    <integer>30</integer>
  </dict>
  <key>Nice</key>
  <integer>10</integer>
  <key>StandardOutPath</key>
  <string>/Users/joselito/Proyecto Auditoria Congreso/data/rutinas/semanal.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/joselito/Proyecto Auditoria Congreso/data/rutinas/semanal.log</string>
</dict>
</plist>
