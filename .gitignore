.venv/
__pycache__/
.DS_Store

# Fuentes pesadas que se pueden volver a descargar de su origen oficial
data/raw/gaceta_*/
data/descargas/*/audio.*

# Estado local del descargador automático
data/descargas/.candado
data/descargas/launchd.log

# Enlace local con el proyecto de Vercel
sitio/.vercel/

# Registros locales de las rutinas
data/rutinas/*.log

# Respaldos y material local que no se publica
privado/

# Clasificaciones individuales sin validar: se publican solo después de la validación humana
data/processed/clasif/
data/processed/*_resumen.json
data/validacion/
reportes/*.html
